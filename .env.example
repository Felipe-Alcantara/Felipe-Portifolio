# Usuário alvo para sincronização de repositórios (obrigatório)
GITHUB_USERNAME=felipe-alcantara

# Token opcional para ampliar rate limit e permitir importação de privados
# Recomendação de escopo: repo (para privados) ou public_repo (somente públicos)
GITHUB_TOKEN=

# Limite opcional de segurança para evitar importação muito grande em uma execução
GITHUB_IMPORT_MAX_REPOS=500
